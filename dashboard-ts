  /* 📋 Newsletter */
  newsletter: {
    totalRegistros: { valor: "16",        delta: "contatos na base",               tipo: "neu" },
    picoMes:        { valor: "Mar/2026",  delta: "↑ concentração dias 18 e 19",    tipo: "up"  },
    ultimoRegistro: "1º de abril/2026 · Jessica",
    dominios:       "@gmail.com · @hotmail.com · @terezasantos.com.br · @vistabiio.com.br",
  },

  /* 🔗 Links clicados */
  links: [
    { nome: "Home (tsstudio.com.br)", pct: 100, val: "Maior vol.", cor: "blue"   },
    { nome: "Instagram",              pct: 60,  val: "Secundário", cor: "pink"   },
    { nome: "WhatsApp",               pct: 50,  val: "Secundário", cor: "green"  },
    { nome: "Blog",                   pct: 20,  val: "Menor vol.", cor: "muted"  },
    { nome: "Contato",                pct: 15,  val: "Menor vol.", cor: "muted"  },
  ],

  /* 🚨 Alertas */
  alertas: [
    { situacao: "Coleção Cápsula com bounce de até 43,88%",              prioridade: "Crítico",      badge: "red",    acao: "Higienizar lista antes do próximo envio"           },
    { situacao: "Taxa de conversão 0% — zero pedidos aprovados",         prioridade: "Crítico",      badge: "red",    acao: "Revisar jornada de compra e CTA do site"           },
    { situacao: "Base com +60% de leads indeterminados",                  prioridade: "Atenção",      badge: "yellow", acao: "Reengajar ou remover contatos inativos"            },
    { situacao: "Coleção Cápsula: abertura 13% vs 27% das demais",       prioridade: "Atenção",      badge: "yellow", acao: "Revisar assunto e segmentação de envio"            },
    { situacao: "Lista de newsletter com apenas 16 registros",            prioridade: "Atenção",      badge: "yellow", acao: "Criar estratégia ativa de captação de leads"       },
    { situacao: "Março com pico de 690 visitas (+290% vs fev)",          prioridade: "Positivo",     badge: "blue",   acao: "Identificar o que impulsionou e replicar"          },
    { situacao: "Campanhas mar/26 com abertura acima de 27%",            prioridade: "Positivo",     badge: "blue",   acao: "Manter frequência e formato dessas campanhas"      },
    { situacao: "Instagram e WhatsApp como canais de interação",          prioridade: "Oportunidade", badge: "green",  acao: "Ampliar integração entre e-mail e redes sociais"   },

      { nome: "Duplicado de Projeto Copa 2",     data: "17/03", leads: 392,  entrega: "94,88%", abertura: "27,76%", cliques: "2,70%",  bounces: "—",      status: "ok"        },
      { nome: "Coleção Cápsula–2026–01",         data: "28/04", leads: 1844, entrega: "56,12%", abertura: "13,01%", cliques: "0,51%",  bounces: "43,88%", status: "alerta"    },
    ],

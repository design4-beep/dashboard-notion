  },

  /* 🌐 Site */
  site: {
    totalVisitas:   { valor: "1.461",  delta: "Jan a 06/mai/2026",   tipo: "neu"  },
    totalUsuarios:  { valor: "1.676",  delta: "período completo",     tipo: "neu"  },
    novosUsuarios:  { valor: "1.228",  delta: "↑ 73% do total",       tipo: "up"   },
    conversao:      { valor: "0%",     delta: "↓ 0 pedidos aprovados",tipo: "down" },
    totalPaginas:   "3.879",

    visitasMensais: {
      labels: ['Jan/26','Fev/26','Mar/26','Abr/26','Mai/26*'],
      data:   [99, 177, 690, 451, 44],
      picos:  ['pico 26/01', 'pico 03/02', 'pico 16/03 · 96 vis.', 'pico 27/04 · 86 vis.', 'até 06/05'],
    },
